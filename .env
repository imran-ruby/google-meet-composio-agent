# =============================================================================
# Google Meet Agent Configuration
# =============================================================================
# Copy this file to .env and fill in your values


# Composio API Key
# Get from: https://app.composio.dev (Settings > API Keys)
COMPOSIO_API_KEY=ak_QAKZGojrH7XxtZLh7x8T


# Anthropic API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=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


# Composio Auth Config ID for Google Meet
# Create at: https://app.composio.dev (Auth Configs > Create > Google Meet)
# The ID starts with "ac_"
COMPOSIO_AUTH_CONFIG_ID=ac_86lT_ffAFV7o


# User ID - unique identifier for this user
# Each person running the script should use their own unique ID
# Can be email, UUID, or any unique string
GOOGLE_MEET_USER_ID=default


# =============================================================================
# Optional Settings
# =============================================================================


# Claude model to use (default: claude-sonnet-4-20250514)
MODEL_NAME=claude-sonnet-4-20250514


# Maximum turns for agent loop (default: 10)
AGENT_MAX_TURNS=10


# OAuth timeout in seconds (default: 300)
OAUTH_TIMEOUT=300
